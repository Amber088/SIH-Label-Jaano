# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# Per-machine assistant config (tool permissions for this checkout only). Ignored for
# the same reason as .vscode/: it describes one developer's setup, not the project, and
# it would otherwise be swept in by `git add -A`.
.claude/

# Logs & temp
*.log
tmp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Secrets — never commit keys
.env
.env.*
!.env.example
*.pem
*.key

# Flutter / Node build output
build/
.dart_tool/
node_modules/
dist/
