# Copy to .env and fill in. backend/.env is gitignored (see ../.gitignore) — the real
# file with real values never gets committed. app/main.py, extract.py and manage.py all
# read it at import time, so `uvicorn app.main:app` picks it up with no extra flags.
#
# Rules the loader follows (backend/envfile.py):
#   * a value already exported in the shell WINS over this file
#   * blank and placeholder values are ignored, so an unfilled line cannot clobber
#     a good shell export
#   * <angle brackets> around a value are stripped — paste the key bare anyway

# Google AI Studio key for live label extraction: https://aistudio.google.com/apikey
# Without this the pipeline silently returns CANNED values and every check passes.
GEMINI_API_KEY=

# Signing key for auth tokens. Generate with: python manage.py secret
# Unset means an ephemeral key, so every restart invalidates every issued token.
LABEL_JAANO_SECRET=

# Required to enrol officer/admin accounts. Fail-closed: enrolment is refused if unset.
LABEL_JAANO_OFFICER_CODE=

# Optional. LABEL_JAANO_MOCK=1 forces the offline deterministic path even with a key.
# LABEL_JAANO_MOCK=1
# LABEL_JAANO_GEMINI_MODEL=gemini-3.6-flash
